<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#E6FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnTopBack"
            android:layout_width="82dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:text="@string/common_back"
            android:textAllCaps="false"
            android:textColor="@color/ai_accent_blue"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/aed_title"
            android:textColor="@color/ai_text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="82dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAedInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:textColor="@color/ai_text_main"
        android:textSize="18sp" />

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnNavigateAed"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_ai_button_soft_blue"
            android:textAllCaps="false"
            android:text="@string/aed_navigate_button"
            android:textColor="@color/ai_accent_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
