<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_gradient_emergency">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="#E6FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <Space
                android:layout_width="82dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/emergency_title"
                android:textColor="@color/ai_text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="82dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/viewPulseDot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_button_primary"
            android:text="" />

        <TextView
            android:id="@+id/tvRescueState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_card"
            android:padding="12dp"
            android:text="@string/emergency_rescue_processing"
            android:textColor="@color/ai_text_main"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:padding="12dp"
            android:text="@string/emergency_steps"
            android:textColor="@color/ai_text_main"
            android:textSize="17sp" />

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnAutoCall"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ai_button_primary"
            android:textAllCaps="false"
            android:text="@string/emergency_auto_call"
            android:textColor="@color/ai_emergency_red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnShareLocation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_button_soft_blue"
            android:textAllCaps="false"
            android:text="@string/emergency_share_location"
            android:textColor="@color/ai_accent_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnOpenArGuide"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_button_soft_blue"
            android:textAllCaps="false"
            android:text="@string/emergency_open_ar"
            android:textColor="@color/ai_accent_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
            android:id="@+id/btnOpenCollaboration"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_button_soft_blue"
            android:textAllCaps="false"
            android:text="@string/emergency_open_collaboration"
            android:textColor="@color/ai_accent_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFinishEmergency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_button_secondary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/emergency_finish_recovery"
            android:textAllCaps="false"
            android:textColor="@color/ai_text_main"
            android:textStyle="bold" />

    </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/emergencyGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="260dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/emergencyGuideStepCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/emergency_popup_title_call"
                    android:textColor="@color/ai_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEmergencyPopupClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="✕"
                    android:textColor="@color/ai_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <Button
                android:id="@+id/btnEmergencyPopupNext"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_ai_button_primary"
                android:backgroundTint="@null"
                android:text="@string/emergency_popup_next"
                android:textAllCaps="false"
                android:textColor="@color/ai_emergency_red"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/emergencyGuideStepActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/emergency_popup_title_actions"
                    android:textColor="@color/ai_text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEmergencyPopupCloseStep2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="✕"
                    android:textColor="@color/ai_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEmergencyPopupAr"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ai_button_primary"
                    android:backgroundTint="@null"
                    android:text="@string/emergency_open_ar"
                    android:textAllCaps="false"
                    android:textColor="@color/ai_emergency_red"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnEmergencyPopupAed"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ai_button_primary"
                    android:backgroundTint="@null"
                    android:text="@string/nav_aed_map"
                    android:textAllCaps="false"
                    android:textColor="@color/ai_emergency_red"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
