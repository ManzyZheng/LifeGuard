<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="#E6FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
                android:id="@+id/btnTopBack"
                android:layout_width="82dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:text="@string/common_back"
                android:textAllCaps="false"
                android:textColor="@color/ai_accent_blue"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/knowledge_title"
                android:textColor="@color/ai_text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="82dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
                android:id="@+id/btnLearnCpr"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_button_soft_blue"
                android:textAllCaps="false"
                android:text="@string/knowledge_cpr"
                android:textColor="@color/ai_accent_blue"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
                android:id="@+id/btnLearnAed"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_button_soft_blue"
                android:textAllCaps="false"
                android:text="@string/knowledge_aed"
                android:textColor="@color/ai_accent_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
                android:id="@+id/btnLearnAirway"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_button_soft_blue"
                android:textAllCaps="false"
                android:text="@string/knowledge_airway"
                android:textColor="@color/ai_accent_blue"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:fontFamily="sans-serif-medium"
                android:id="@+id/btnLearnBleeding"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_button_soft_blue"
                android:textAllCaps="false"
                android:text="@string/knowledge_bleeding"
                android:textColor="@color/ai_accent_blue"
                android:textStyle="bold" />
        </LinearLayout>

            <TextView
                android:id="@+id/tvKnowledgeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card"
                android:padding="12dp"
                android:text="@string/knowledge_prompt_select"
                android:textColor="@color/ai_text_main"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/layoutKnowledgeImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
